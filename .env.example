# Copy to .env. docker compose reads it automatically.

# First-boot admin account. Ignored once users.yaml has this username.
# Leave blank for no login at all.
PRINTDECK_ADMIN_USERNAME=you
PRINTDECK_ADMIN_PASSWORD=change-me

# Optional. Defaults suit a standalone clone.

# Host directory for printers.yaml + users.yaml. Default: ./data
# PRINTDECK_DATA_DIR=/srv/data/printdeck

# Host port. Default: 8000
# PRINTDECK_PORT=8000

# Image tag when pulling instead of building. Default: latest
# PRINTDECK_IMAGE_TAG=latest

# Reverse proxy IP(s), comma-separated, or "*" if only the proxy can reach
# the container. Without it every client looks like the proxy to the login
# rate limiter.
# PRINTDECK_FORWARDED_ALLOW_IPS=172.18.0.2

# Without Docker: where the app keeps its two YAML files. Default: repo root.
# PRINTDECK_PRINTERS=/path/to/printers.yaml
# PRINTDECK_USERS=/path/to/users.yaml
