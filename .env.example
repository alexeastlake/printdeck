# Copy to .env (gitignored) and fill in. docker compose reads this automatically.
#
# These only matter on the very first boot, when users.yaml doesn't exist yet
# (or doesn't have this username) — they bootstrap one admin account. After
# that, users.yaml is the source of truth; add/remove/edit accounts from the
# Users page in the app instead of editing these. Leave both blank to run
# with no login at all.
PRINTDECK_ADMIN_USERNAME=you
PRINTDECK_ADMIN_PASSWORD=change-me

# Everything below is optional — uncomment only if the default doesn't suit
# your deployment (a standalone clone doesn't need any of this).

# Where printers.yaml/users.yaml live on the host. Defaults to "." (next to
# docker-compose.yml). An external deployment that has its own persistent
# storage convention (e.g. a homelab's backed-up data volume) would point
# this there instead — see the Docker section of the README.
# PRINTDECK_DATA_DIR=/srv/data/printdeck

# Host port to publish. Defaults to 8000.
# PRINTDECK_PORT=8000

# Which published image tag to run when *not* building locally (i.e. no
# --build, and no source tree present) — see .github/workflows/. Defaults
# to "latest".
# PRINTDECK_IMAGE_TAG=latest
