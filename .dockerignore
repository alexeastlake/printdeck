# Keep the build context (and image) small and free of host/secret files.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets and per-host data — provided at runtime, never baked into the image.
.env
printdeck.env
printers.yaml

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
