# Keep the build context (and image) small and free of host/secret files.
.venv/
venv/
.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets and per-host data. Provided at runtime, never baked into the image.
.env
printdeck.env
printers.yaml
users.yaml

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker compose default data directory. Mounted at runtime, never baked in
data/
.ruff_cache/
.github/
tests/
